# 复制为 .env 后填写。没有密钥也能开播排练，小鲸鱼会用本地口吻接话。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 服务监听地址。默认只本机。
WHALE_ADDR=127.0.0.1:8787

# 非本机推弹幕时使用。本机默认不校验。
WHALE_INGEST_TOKEN=
# WHALE_INGEST_STRICT=true

# 可选 MySQL。默认关闭，演示只写 data/interactions.jsonl。
WHALE_MYSQL_ENABLED=false
WHALE_MYSQL_DSN=

# WHALE_LOG_FILE=data/interactions.jsonl
# WHALE_MOCK_AUTOSTART=false

# 本地 edge-tts。默认开启；关掉则退回浏览器朗读。
WHALE_TTS_ENABLED=true
WHALE_TTS_VOICE=zh-CN-XiaoyiNeural
# WHALE_TTS_PYTHON=py
